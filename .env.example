# Operator must set DATABASE_URL before starting. Put the real connection string only in the uncommitted .env file.
DATABASE_URL=
POSTGRES_USER=scoutdeck
# Operator must set POSTGRES_PASSWORD before starting.
POSTGRES_PASSWORD=
POSTGRES_DB=scoutdeck
# Operator must set SCOUTDECK_ACCESS_SECRET before starting.
SCOUTDECK_ACCESS_SECRET=
